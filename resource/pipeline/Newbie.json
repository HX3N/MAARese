{
    "Newbie": {
        "focus": "[color:#4FA3FF]▶ 초보자 헤드헌팅[/color]",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetSpeakers",
                "custom_action_param": {
                    "templates": [
                        "Public/DialogDonkey.png",
                        "Public/DialogPRTS.png",
                        "Public/DialogDobermann.png"
                    ]
                }
            }
        },
        "next": ["[JumpBack]Loading", "Newbie_Exit", "[JumpBack]DialogNext"]
    },
    "Newbie_Exit": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "Dialog",
                "custom_recognition_param": { "area": "upper", "text": "우선은한번진행해보도" }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry",
                "custom_action_param": { "click": [800, 620, 200, 60], "pre_click": true }
            }
        },
        "on_error": ["Newbie_Exit", "Newbie_Pull"],
        "next": ["Newbie_Pull"]
    },

    "Newbie_Pull": {
        "focus": "1회 진행",
        "next": ["[JumpBack]Loading", "Newbie_Pull_Skip"]
    },
    "Newbie_Pull_Skip": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": ["GachaSkip"]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": ["Newbie_Pull_Spam"]
    },
    "Newbie_Pull_Spam": {
        "doc": "아미야 대화가 나올 때까지 중앙 연타",
        "action": {
            "type": "Click",
            "param": {
                "target": [440, 260, 400, 200]
            }
        },
        "next": ["Newbie_Pull_Exit", "Newbie_Pull_Spam"]
    },
    "Newbie_Pull_Exit": {
        "doc": "대사 문구는 써지는 도중 연타에 넘어가므로 다이얼로그 프로필로 판단",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": ["DialogNext"]
            }
        },
        "next": ["Newbie_Squad"]
    },

    "Newbie_Squad": {
        "focus": "분대 편성",
        "next": [
            "[JumpBack]Loading",
            "Newbie_GoHome_Exit",
            "Newbie_Squad_Exit",
