            "[JumpBack]Newbie_EnterStage_EvilTime_Confirm",
            "[JumpBack]Newbie_EnterStage_EvilTime",
            "[JumpBack]Newbie_EnterStage_Story",
            "[JumpBack]DialogNext"
        ]
    },
    "Newbie_EnterStage_Story": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Newbie/EnterStory.png",
                "roi": [180, 570, 285, 145]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "Newbie_EnterStage_EvilTime": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Newbie/EnterEvilTime.png",
