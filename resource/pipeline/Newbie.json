        ]
    },
    "Newbie_Squad_Add": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "Dialog",
                "custom_recognition_param": {
                    "area": "upper",
                    "text": "이쪽을터치하여오퍼레"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry",
                "custom_action_param": { "click": [517, 144, 91, 133], "pre_click": true }
            }
        },
        "on_error": ["Newbie_Squad"]
    },
    "Newbie_Squad_Select": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "Dialog",
                "custom_recognition_param": { "area": "upper", "text": "오퍼레이터를선택하고" }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry",
                "custom_action_param": { "click": [390, 126, 109, 146], "pre_click": true }
            }
        },
        "on_error": ["Newbie_Squad"]
    },
    "Newbie_Squad_Exit": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "Dialog",
                "custom_recognition_param": { "area": "upper", "text": "확인버튼을터치하여주" }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry",
                "custom_action_param": { "click": [1051, 662, 126, 40], "pre_click": true }
            }
        },
        "on_error": ["Newbie_Squad"],
        "next": ["Newbie_GoHome"]
