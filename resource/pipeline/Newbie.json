    "Newbie_Branch": {
        "doc": "리세 전략에 따라 탈출구 노드 하나만 활성화 (0-1 / 0-1 연장 전략 Newbie_Branch_Exit_Mail, 0-11 전략 Newbie_Branch_Exit_Stage01)",
        "next": ["Newbie_Branch_Exit_Mail", "Newbie_Branch_Exit_Stage01"]
    },
