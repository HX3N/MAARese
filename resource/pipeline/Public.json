{
    "DialogArea": {
        "doc": "Dialog가 expected를 덮어써 실행하는 대화창 첫 줄 OCR",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [210, 65, 700, 45],
                "replace": [
                    ["([가-힣])[A-Za-z\\[\\]{}|]+([가-힣])", "$1$2"],
                    ["[!\"'(),\\-./:=?@\\[\\]_{}~—…★]", ""]
                ]
            }
        }
    },
    "DeploySwipe": {
        "doc": "Deploy가 좌표를 덮어써 실행하는 스와이프. 직접 실행 동작의 기본 지연 제거",
        "pre_delay": 0,
        "post_delay": 0,
        "action": {
            "type": "Swipe"
        }
    },
    "DeployCost": {
        "doc": "DeployReady가 읽는 배치 코스트 숫자",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1199, 494, 80, 44],
                "expected": "^\\d+$",
                "threshold": 0.7,
                "model": "en_us",
                "only_rec": true,
                "color_filter": "CostBinarize",
                "replace": [
                    ["[Oo]", "0"],
                    ["[IiLl]", "1"],
                    ["[\\{\\}\\[\\]]", "1"],
                    ["B", "8"],
                    ["^\\.", ""],
                    [" ", ""]
                ]
            }
        }
    },
    "CostArea": {
        "doc": "roi 참조용 고정 영역: 전투 배치 코스트 숫자",
        "recognition": {
            "type": "DirectHit",
            "param": {
                "roi": [1199, 494, 80, 44]
            }
        }
    },
    "LowerDialogArea": {
        "doc": "Dialog가 expected를 덮어써 실행하는 아래쪽 대화창 첫 줄 OCR",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [245, 505, 700, 45],
                "replace": [
                    ["([가-힣])[A-Za-z\\[\\]{}|]+([가-힣])", "$1$2"],
                    ["[!\"'(),\\-./:=?@\\[\\]_{}~—…★]", ""]
                ]
            }
        }
    },
    "GameDownReset": {
        "doc": "노드 실패(on_error)·타임아웃 초과(Watchdog) 시 화면 문구로 원인 구분 후 리세 재시작. loop_limit_min = interface 타임아웃",
        "attach": { "loop_limit_min": 3 },
        "next": ["GameDownReset_Network", "GameDownReset_Update", "GameDownReset_Unknown"]
    },
    "GameDownReset_Network": {
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ 네트워크 연결 끊김, 재시작[/color]",
                "display": ["log", "toast"]
            }
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [275, 310, 729, 42],
                "expected": ["네트워크", "로그인"]
            }
        },
        "next": ["[Anchor]GameDownNext", "GameDownStop"]
    },
    "GameDownReset_Update": {
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ 게임 데이터 동기화 (4시), 재시작[/color]",
                "display": ["log", "toast"]
            }
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [275, 310, 729, 42],
                "expected": ["업데이트", "동기화"]
            }
        },
        "next": ["[Anchor]GameDownNext", "GameDownStop"]
    },
    "GameDownReset_Unknown": {
        "focus": {
            "Node.PipelineNode.Starting": {
                "content": "[color:#FFD700]⚠ 예상치 못한 오류, 재시작[/color]",
                "display": ["log", "toast"]
            }
        },
        "next": ["[Anchor]GameDownNext", "GameDownStop"]
    },
    "GameDownStop": {
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ 귀환점 없음, 작업 종료[/color]",
                "display": ["log", "toast"]
            }
        },
        "doc": "GameDownNext가 없는 진입에서 재귀 없이 작업 종료"
    },
    "DialogNext": {
