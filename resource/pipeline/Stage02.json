{
    "Stage02": {
        "focus": "[color:#4FA3FF]▶ 0-2[/color]",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetSpeakers",
                "custom_action_param": {
                    "templates": [
                        "Public/DialogDonkey.png",
                        "Public/DialogPRTS.png",
                        "Public/DialogDobermann.png"
                    ]
                }
            }
        },
        "next": ["Stage02_StageSelect"]
    },

    "Stage02_StageSelect": {
        "focus": "스테이지 선택",
        "next": ["[JumpBack]Loading", "[JumpBack]DialogNext", "Stage02_StageSelect_Exit"]
    },
    "Stage02_StageSelect_Exit": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 190, 1280, 310],
                "expected": "^0-2$",
                "replace": [
                    ["[Oo]", "0"],
                    ["[IiLl]", "1"],
                    ["[\\{\\}\\[\\]]", "1"],
                    ["B", "8"],
                    ["^\\.", ""],
                    [" ", ""]
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": ["Stage02_Start"]
    },

    "Stage02_Start": {
        "focus": "작전 개시",
        "anchor": { "OperationStartRetry": "Stage02_Start" },
        "next": [
            "[JumpBack]Loading",
            "Stage02_Start_Exit",
            "[JumpBack]OperationStart",
            "[JumpBack]DialogNext"
        ]
    },
    "Stage02_Start_Exit": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": ["SquadFormatGuide"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [948, 20, 206, 42]
            }
        },
        "next": ["Stage02_SquadGuide"]
    },

    "Stage02_SquadGuide": {
        "focus": "편성 안내",
        "next": ["[JumpBack]Loading", "Stage02_SquadGuide_Exit", "[JumpBack]DialogNext"]
    },
    "Stage02_SquadGuide_Exit": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": ["SquadRequestPopup"]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry"
            }
        },
        "on_error": ["Stage02_SquadGuide_Exit", "Stage02_Medic"],
        "next": ["Stage02_Medic"]
    },

    "Stage02_Medic": {
        "focus": "메딕 편성",
        "anchor": { "BattleEnterNext": "Stage02_DeployNoirCorne" },
        "next": ["Stage02_Medic_Hibiscus"]
    },
    "Stage02_Medic_Hibiscus": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SelectOperator",
                "custom_action_param": { "operator_name": "히비스커스" }
            }
        },
        "on_error": ["Stage02_Medic"],
        "next": ["Stage02_Medic_Exit"]
    },
    "Stage02_Medic_Exit": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": ["OperatorSelectConfirm"]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry"
            }
        },
        "on_error": ["Stage02_MedicConfirm"],
        "next": ["BattleEnter"]
    },
    "Stage02_MedicConfirm": {
        "focus": "메딕 편성 · 확인",
        "next": ["[JumpBack]Loading", "BattleEnterReady", "Stage02_Medic_Exit"]
    },

