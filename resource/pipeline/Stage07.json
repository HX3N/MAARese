            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry",
                "custom_action_param": { "click": [1050, 98, 110, 217], "pre_click": true }
            }
        },
        "on_error": ["Stage07_Formation_Exit", "Stage07_SupportGuide"],
        "next": ["Stage07_SupportGuide"]
    },

    "Stage07_SupportGuide": {
        "focus": "지원 유닛 안내",
