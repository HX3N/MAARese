{
    "Account_Entry": {
        "doc": "interface Debug 시작 노드가 있으면 next를 그 노드로 교체",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "StartNode",
                "custom_action_param": { "node": "" }
            }
        },
        "next": ["Account_Resolution", "Account"]
    },
    "Account_Resolution": {
        "doc": "기기 원본 해상도가 1280×720이 아닐 때 적중하는 센서",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ResolutionMismatch",
                "custom_recognition_param": {}
            }
        },
        "next": ["Account_Resolution_Notice"]
    },
    "Account_Resolution_Notice": {
        "doc": "ResolutionMismatch가 현재 해상도를 문구에 넣는 해상도 안내",
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ 1280×720이 아닌 해상도, 계속 진행[/color]",
                "display": ["log", "toast"]
            }
        },
        "next": ["Account"]
    },
    "Account": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AccountWipe",
                "custom_action_param": {}
            }
        },
        "anchor": { "GameDownNext": "Account" },
        "on_error": ["Account_RootFail"],
        "next": ["Account_LaunchApp"]
    },
    "Account_RootFail": {
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ 루트 권한 없음, 작업 종료(루트를 켜고 다시 실행)[/color]",
                "display": ["log", "modal"]
            }
        },
        "doc": "AccountWipe 실패(su 실행 불가) 시 안내 후 작업 종료"
    },
    "Account_LaunchApp": {
        "doc": "게임 실행, 실패 시 안내 후 작업 종료",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "LaunchApp",
                "custom_action_param": {}
            }
        },
        "on_error": ["Account_LaunchFail"],
        "next": ["Account_Launch"]
    },
    "Account_LaunchFail": {
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ 게임 실행 실패, 작업 종료[/color]",
                "display": ["log", "modal"]
            }
        },
        "doc": "LaunchApp 실패(앱 없음·기기 응답 없음) 시 안내 후 작업 종료"
    },

    "Account_Task": {
        "doc": "next = interface 작업 방식",
        "next": ["Account_Load"]
    },
    "Account_Load": {
        "focus": "[color:#4FA3FF]▶ 계정 불러오기[/color]",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AccountLoad",
                "custom_action_param": { "account": "" }
            }
        },
        "next": ["Account_LaunchApp"]
    },

    "Account_LoadSync": {
        "focus": "로그인 공지 닫기",
        "anchor": { "LoginSyncRetry": "Account_LoadSync" },
        "next": ["Account_Login_Sync"]
    },
    "Account_Launch": {
        "focus": "[color:#4FA3FF]▶ 게임 실행[/color]",
        "next": [
            "[JumpBack]Loading",
            "Account_Login_Name",
            "[JumpBack]Account_Loading",
            "[JumpBack]Account_Launch_MuMuAd",
            "Account_Launch_Exit_Logout",
            "[JumpBack]Account_Launch_Download",
            "[JumpBack]Account_Launch_Voice",
            "[JumpBack]Account_Launch_Start",
            "[JumpBack]Account_Launch_CheckResource",
            "[JumpBack]Account_Launch_Update",
            "[JumpBack]Account_Launch_Notice",
            "Account_Launch_Exit"
        ]
    },
    "Account_Launch_MuMuAd": {
        "doc": "MuMu 스토어 광고 오버레이. 광고 제거 뱃지 오른쪽의 × 클릭",
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "[color:#FFD700]⚠ MuMu 광고, 닫기[/color]",
                "display": ["log"]
            }
        },
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "ad",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "Account/MuMuAd.png",
                                "roi": [973, 62, 210, 96]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "Account/MuMuAdExit.png",
                                "roi": "ad",
                                "roi_offset": [76, -4, -30, 8]
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry"
            }
        },
        "on_error": ["Account_Launch"]
    },
    "Account_Launch_Download": {
        "doc": "게임 나가기 버튼이 있는 리소스 다운로드 팝업",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [466, 433, 96, 26],
                "expected": "게임나가기"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRetry",
                "custom_action_param": { "click": [743, 432, 47, 28] }
            }
        },
        "on_error": ["Account_Launch"]
    },
